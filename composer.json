{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bagart/telegram-bot-stt-module",
    "description": "Speech-to-text module for the Telegram bot platform: /text command, auto transcription mode, OpenAI-compatible STT providers (Groq Whisper, self-hosted)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "telegram",
        "tg-bot",
        "telegram-bot",
        "bot-platform",
        "stt",
        "speech-to-text",
        "whisper",
        "transcription",
        "module"
    ],
    "authors": [
        {
            "name": "BAGArt (Artur Baltaev)",
            "email": "baltaev.artur+ask@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "bagart/telegram-bot-lib": "*",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "BAGArt\\TelegramBotStt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BAGArt\\TelegramBotStt\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php ../../../vendor/bin/phpunit --testsuite SttModule"
        ]
    }
}
